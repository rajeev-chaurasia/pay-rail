# Synthetic local defaults only. Never place real secrets in this file.
# Compose ports; application settings must be forwarded to its environment.
PAYRAIL_HTTP_PORT=18080
PAYRAIL_POSTGRES_PORT=15432
PAYRAIL_REDIS_PORT=16379
PAYRAIL_KAFKA_PORT=19092
DATABASE_URL=jdbc:postgresql://localhost:15432/payrail
DATABASE_USER=payrail
DATABASE_PASSWORD=payrail
REDIS_HOST=localhost
REDIS_PORT=16379
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
PORT=18080
DB_POOL_SIZE=20
API_KEY_PEPPER=local-development-pepper-change-me
MIGRATION_ADMIN_TOKEN=local-admin-token
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=600
OUTBOX_ENABLED=true
MIGRATION_DUAL_WRITE=true
MIGRATION_SHADOW_READ_PERCENT=0
MIGRATION_V2_READ_PERCENT=0
PAYRAIL_URL=http://localhost:18080
